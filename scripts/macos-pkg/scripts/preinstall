#!/bin/bash
# preinstall — runs as root before the .pkg payload is laid down.
#
# Stop running app processes before the payload swap and remove stray
# DMG files from past installs. Legacy hosts and helper cleanup runs in
# the new app, where it can snapshot the live file and report failure.

set +e

LOG=/var/log/redd-block-pkg-preinstall.log
exec > >(tee -a "$LOG") 2>&1
echo "=== preinstall $(date '+%F %T') ==="

SCRIPT_DIR="$(dirname "$0")"
# shellcheck source=scripts/macos-pkg/scripts/sessions.sh
source "$SCRIPT_DIR/sessions.sh" || exit 1

# Keep the restart list private to this transaction. If it cannot be created,
# leave the running app alone and stop before replacing its bundle.
if ! (umask 077; set -o noclobber; : > "$RESTART_UIDS_FILE"); then
    echo "could not create the package restart list"
    exit 1
fi

is_installed_app_executable() {
    local app_path="${1%/Contents/MacOS/*}"
    case "$app_path" in
        "$APP_PATH"|"$LEGACY_REDD_BLOCKER_APP_PATH"|"$LEGACY_REDD_BLOCK_APP_PATH"|"$FRISTED_APP_PATH")
            local bundle_name="${app_path##*/}"
            [[ "$1" == "$app_path/Contents/MacOS/redd-block" ||
               "$1" == "$app_path/Contents/MacOS/${bundle_name%.app}" ]]
            ;;
        *) return 1 ;;
    esac
}

is_native_host() {
    # Keep the browser argv markers aligned with native_host::is_native_host_invocation.
    [[ "$1" =~ (^|[[:space:]])(--native-host|mindshield@example\.com)([[:space:]]|$) ||
       "$1" =~ (^|[[:space:]])(chrome-extension://|--parent-window=) ]]
}

stop_install_processes() {
    local signal="$1"
    local processes pid uid executable args restore_session process current_uid current_executable
    if ! processes=$(/bin/ps -axww -o pid= -o uid= -o comm=); then
        echo "could not enumerate running apps for SIG$signal"
        return
    fi
    while read -r pid uid executable; do
        is_installed_app_executable "$executable" || continue
        [[ "$pid" =~ ^[1-9][0-9]*$ && "$pid" != "$$" ]] || continue
        args=$(/bin/ps -ww -p "$pid" -o args=) || continue
        # Browser-launched native hosts also hold the old bundle open.
        # Browsers reconnect on demand. Restore only GUI app sessions.
        restore_session=false
        if ! is_native_host "$args" && is_gui_user "$uid"; then
            restore_session=true
        fi

        # Recheck the owner and executable because macOS can recycle a PID.
        process=$(/bin/ps -ww -p "$pid" -o uid= -o comm=) || continue
        read -r current_uid current_executable <<< "$process"
        [[ "$current_uid" == "$uid" && "$current_executable" == "$executable" ]] || continue
        if $restore_session && ! printf '%s\n' "$uid" >> "$RESTART_UIDS_FILE"; then
            echo "could not record GUI uid $uid; leaving app process $pid running"
            continue
        fi
        kill "-$signal" "$pid" 2>/dev/null
    done <<< "$processes"
    return 0
}

# The app vetoes ordinary AppleScript quit requests. Signal the exact
# installed executables, including old names, with time to exit first.
stop_install_processes TERM
sleep 2
stop_install_processes KILL
sleep 1

# Clean up stale Tauri DMG temp files that earlier builds of this
#     .pkg accidentally laid down alongside the .app in /Applications.
#     Best-effort: never fail the install on this.
shopt -s nullglob 2>/dev/null || true
for f in '/Applications/rw.'*'.Digital Habits Blocker_'*'_universal.dmg' \
         '/Applications/._rw.'*'.Digital Habits Blocker_'*'_universal.dmg' \
         '/Applications/rw.'*'.ReDD Blocker_'*'_universal.dmg' \
         '/Applications/._rw.'*'.ReDD Blocker_'*'_universal.dmg'; do
    [ -e "$f" ] || continue
    rm -f "$f" && echo "removed stray $f"
done

exit 0
