#!/bin/bash
# postinstall — runs as root after the .pkg payload is laid down.
#
# Open the installed app in the console user's desktop and restore app
# sessions stopped by preinstall. Also remove legacy bundles so upgrades
# leave one app in Applications.

set +e

LOG=/var/log/redd-block-pkg-postinstall.log
exec > >(tee -a "$LOG") 2>&1
echo "=== postinstall $(date '+%F %T') ==="

SCRIPT_DIR="$(dirname "$0")"
# shellcheck source=scripts/macos-pkg/scripts/sessions.sh
source "$SCRIPT_DIR/sessions.sh" || exit 1

if [ -d "$LEGACY_REDD_BLOCKER_APP_PATH" ]; then
    rm -rf "$LEGACY_REDD_BLOCKER_APP_PATH" && echo "removed legacy app: $LEGACY_REDD_BLOCKER_APP_PATH"
fi
if [ -d "$LEGACY_REDD_BLOCK_APP_PATH" ]; then
    rm -rf "$LEGACY_REDD_BLOCK_APP_PATH" && echo "removed legacy app: $LEGACY_REDD_BLOCK_APP_PATH"
fi
if [ -d "$FRISTED_APP_PATH" ]; then
    rm -rf "$FRISTED_APP_PATH" && echo "removed legacy app: $FRISTED_APP_PATH"
fi

# Block page SVG must be readable by Safari (file:// loads as the user).
BLOCKED_RES="${APP_PATH}/Contents/Resources/blocked"
if [ -d "$BLOCKED_RES" ]; then
    chmod 644 "$BLOCKED_RES"/* 2>/dev/null && echo "fixed block page resource permissions"
fi

# Run file operations in the user's home with their own permissions.
# Preserve agents pointing to the current bundle so a fresh launch cannot
# be terminated by booting out its job.
scrub_stale_autostart_plists_for_user() {
    run_as_gui_user "$1" /bin/bash -s -- "$1" "$APP_PATH" \
        "$LEGACY_REDD_BLOCKER_APP_PATH" "$LEGACY_REDD_BLOCK_APP_PATH" "$FRISTED_APP_PATH" <<'SCRUB'
uid="$1"
app_path="$2"
shift 2
for plist in "$HOME/Library/LaunchAgents/"*.plist; do
    [ -f "$plist" ] || continue
    /usr/bin/grep -qaF "$app_path" "$plist" && continue
    name=$(printf '%s' "${plist##*/}" | /usr/bin/tr '[:upper:]' '[:lower:]')
    case "$name" in
        *reddblock*|*redd-block*|fristed.plist) ;;
        *) /usr/bin/grep -qaF -e "$1" -e "$2" -e "$3" "$plist" || continue ;;
    esac
    /bin/launchctl bootout "gui/$uid" "$plist" 2>/dev/null || true
    /bin/rm -f "$plist" && echo "removed stale LaunchAgent: $plist"
done
SCRUB
}

# Installer.app, sudo and MDM may supply root or an authorising account.
# The console device identifies the frontmost desktop (or root at login).
console_uid=$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null)
{
    printf '%s\n' "$console_uid"
    if [ -f "$RESTART_UIDS_FILE" ]; then
        /bin/cat "$RESTART_UIDS_FILE"
    fi
} | /usr/bin/sort -u | while IFS= read -r uid; do
    is_gui_user "$uid" || continue
    scrub_stale_autostart_plists_for_user "$uid"

    open_args=()
    if [ "$uid" != "$console_uid" ]; then
        open_args=(-g)
    fi

    # Installer's TMPDIR disappears with the package sandbox. Use the
    # default in the user's session instead.
    if run_as_gui_user "$uid" /usr/bin/env -u TMPDIR /usr/bin/open "${open_args[@]}" "$APP_PATH"; then
        echo "postinstall launched Digital Habits Blocker for GUI uid $uid"
    else
        echo "could not launch Digital Habits Blocker for GUI uid $uid"
    fi
done

exit 0
