{
  "name": "redd-block",
  "version": "3.12.0",
  "description": "Digital Habits: Blocker",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "preinstall": "node ./scripts/only-pnpm.js",
    "dev": "node ./scripts/ensure-dev-icons.js && pnpm run tauri dev",
    "icons:generate": "node ./scripts/generate-icons-from-svg.js",
    "dev:ios": "bash ./scripts/ios-dev.sh",
    "build": "pnpm run tauri build",
    "build:mac": "bash ./scripts/build-mac.sh",
    "build:mac-pkg": "./scripts/build-mac-pkg.sh --release",
    "build:mac-pkg:debug": "./scripts/build-mac-pkg.sh",
    "build:mac-all": "pnpm run build:mac && pnpm run build:mac-pkg",
    "build:ios": "bash ./scripts/ios-appstore-build.sh",
    "build:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win.ps1",
    "build:win:unsigned": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win.ps1 -Unsigned",
    "build:win-store": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win-store.ps1",
    "build:win-test": "powershell -ExecutionPolicy Bypass -File ./scripts/build-win-test.ps1",
    "sign:win-store-msix": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-msix-dev.ps1",
    "tauri": "node ./scripts/run-tauri.js",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:build:e2e": "vite build --mode e2e",
    "build:e2e-app": "pnpm run tauri build --debug --no-bundle --features e2e-webdriver --config src-tauri/tauri.e2e.conf.json",
    "build:system:mac": "node ./scripts/build-system-test-macos.mjs",
    "test:system:mac": "node ./scripts/run-system-test-macos.mjs",
    "test:tier2": "wdio run e2e/wdio.conf.js",
    "test:tier0": "vitest run --config vitest.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "vite:preview": "vite preview",
    "test:tier1": "node scripts/ci/run-tier1-headless.mjs",
    "ui:shoot": "node scripts/ui/shoot.mjs",
    "clean:build-cache": "node ./scripts/clean-build-cache.js"
  },
  "keywords": [
    "blocker",
    "focus",
    "productivity",
    "tauri",
    "website-blocker",
    "app-blocker"
  ],
  "author": {
    "name": "Centre for Digital Habits",
    "email": "team@digitalhabits.org"
  },
  "license": "CC-BY-NC-ND-3.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-shell": "~2.3.6",
    "emoji-picker-element": "^1.29.1",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/tauri-service": "^1.5.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "playwright": "^1.65.0",
    "png-to-ico": "^3.0.2",
    "rollup-plugin-visualizer": "^7.1.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0"
  }
}
