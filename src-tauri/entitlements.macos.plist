<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the hardened-runtime parent app to send Apple Events
	     (AppleScript) to other apps. Without this, macOS denies the event
	     with errAEEventNotPermitted (-1743) in the signed build even after
	     the user grants Automation permission. Drives the JOMO-style
	     website automation in web_automation.rs (reads/redirects Safari +
	     Chromium tabs). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Required for WKWebView getUserMedia in hardened-runtime builds
	     distributed outside the Mac App Store (Developer ID .pkg/.dmg). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
