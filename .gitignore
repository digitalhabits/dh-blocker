.claude/
# Dependencies
node_modules/
# pnpm is the only supported package manager (see AGENTS.md). Ignored rather
# than merely deleted so a stray `npm install` cannot re-commit a second
# lockfile that nothing in CI validates.
package-lock.json
yarn.lock

# Build outputs
dist/
build/
appx-build/
msix-build/
msix-build-test/
src-tauri/tauri.signing.generated.conf.json
*.appx
*.dmg
*.exe
*.AppImage
*.deb
*.rpm

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.local
*.pem
*.p12
*.pfx
*.jks
*.keystore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Helper compiled binary (should be rebuilt locally)
helper/dist/

# Generated assets (run scripts/generate-*.js to create)
assets/appx/
# assets/store

# Tauri build artifacts
src-tauri/target/
# Accidental nested target dirs when build tooling runs from subdirectories
src-tauri/src-tauri/target/

# Tauri autogenerated plugin permissions (regenerated on build)
tauri-plugin-screentime/permissions/autogenerated/
tauri-plugin-screentime/permissions/schemas/

# Distribution builds
for-distribution/
for-distribution/

# Unrelated nested repo checked out in the working tree
redd-focus-web/

# WebdriverIO run logs (Tier 2 e2e)
logs/

# UI screenshot harness output (scripts/ui/shoot.mjs) — regenerate, never commit.
artifacts/
